rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUserDoc(data) {
      // createdAt is intentionally not policed here — it's written via
      // FieldValue.serverTimestamp(), and a plain budget/currency edit
      // merge-writes just that one field, so requiring createdAt to
      // already be a certain shape on every write is fragile for no real
      // security benefit (this doc has a single owner and no other
      // reader). currencySymbol, currencyCode, monthStartDay and
      // photoBase64 are optional (older accounts predate them).
      // photoBase64's cap leaves headroom under Firestore's 1 MiB document
      // size limit alongside the doc's other fields.
      return data.monthlyBudget is number && data.monthlyBudget >= 0
        && (!('currencySymbol' in data.keys())
            || (data.currencySymbol is string
                && data.currencySymbol.size() > 0
                && data.currencySymbol.size() <= 10))
        && (!('currencyCode' in data.keys())
            || (data.currencyCode is string && data.currencyCode.size() <= 10))
        && (!('monthStartDay' in data.keys())
            || (data.monthStartDay is int
                && data.monthStartDay >= 1
                && data.monthStartDay <= 31))
        && (!('photoBase64' in data.keys())
            || data.photoBase64 == null
            || (data.photoBase64 is string && data.photoBase64.size() <= 900000));
    }

    function isValidTransaction(data) {
      // walletId is optional: transactions from before wallets don't have it.
      return data.keys().hasOnly(['title', 'amount', 'type', 'categoryId', 'date', 'note', 'walletId'])
        && data.keys().hasAll(['title', 'amount', 'type', 'categoryId', 'date', 'note'])
        && (!('walletId' in data.keys()) || data.walletId == null || data.walletId is string)
        && data.title is string && data.title.size() <= 100
        && data.amount is number && data.amount > 0
        && data.type in ['income', 'expense']
        && (data.categoryId == null || data.categoryId is string)
        && data.date is timestamp
        && (data.note == null || (data.note is string && data.note.size() <= 500));
    }

    function isValidCategory(data) {
      // sortOrder is optional — categories created before manual reordering
      // existed don't have it.
      // excludeFromBudget is optional too: older categories don't have it.
      return data.keys().hasOnly(['name', 'iconKey', 'color', 'type', 'sortOrder', 'excludeFromBudget', 'createdAt'])
        && data.keys().hasAll(['name', 'iconKey', 'color', 'type', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.iconKey is string && data.iconKey.size() > 0 && data.iconKey.size() <= 40
        && data.color is int
        && data.type in ['income', 'expense']
        && (!('sortOrder' in data.keys()) || data.sortOrder is int)
        && (!('excludeFromBudget' in data.keys()) || data.excludeFromBudget is bool)
        && data.createdAt is timestamp;
    }

    function isValidWallet(data) {
      return data.keys().hasOnly(['name', 'iconKey', 'color', 'openingBalance', 'sortOrder', 'createdAt'])
        && data.keys().hasAll(['name', 'iconKey', 'color', 'openingBalance', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.iconKey is string && data.iconKey.size() > 0 && data.iconKey.size() <= 40
        && data.color is int
        && data.openingBalance is number
        && (!('sortOrder' in data.keys()) || data.sortOrder is int)
        && data.createdAt is timestamp;
    }

    // Someone whose money the user keeps in their wallets (an amanat).
    function isValidPerson(data) {
      return data.keys().hasOnly(['name', 'createdAt'])
        && data.keys().hasAll(['name', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.createdAt is timestamp;
    }

    // One thing that happened in a wallet: spent, own money added, money
    // received from someone to keep, money sent back to them, a move to
    // another wallet, or a correction (the only kind with a signed amount).
    function isValidWalletEntry(data) {
      return data.keys().hasOnly(['kind', 'walletId', 'toWalletId', 'personId', 'amount', 'date', 'note', 'createdAt'])
        && data.keys().hasAll(['kind', 'walletId', 'amount', 'date', 'createdAt'])
        && data.kind in ['spend', 'add', 'receive', 'giveBack', 'transfer', 'adjust']
        && data.walletId is string
        && data.amount is number
        && (data.kind == 'adjust' || data.amount > 0)
        && (!('toWalletId' in data.keys()) || data.toWalletId == null || data.toWalletId is string)
        && (data.kind != 'transfer'
            || (data.toWalletId is string && data.toWalletId != data.walletId))
        && (!('personId' in data.keys()) || data.personId == null || data.personId is string)
        && (!(data.kind in ['receive', 'giveBack']) || data.personId is string)
        && data.date is timestamp
        && (!('note' in data.keys()) || data.note == null || (data.note is string && data.note.size() <= 200))
        && data.createdAt is timestamp;
    }

    // Money the user owes and pays back over time. Without a schedule
    // (frequency 'none') there's no installment or due date.
    function isValidRepayment(data) {
      return data.keys().hasOnly(['name', 'lender', 'total', 'paidBefore', 'frequency', 'everyMonths', 'installment', 'nextDue', 'anchorDay', 'paySource', 'categoryId', 'walletId', 'createdAt'])
        && data.keys().hasAll(['name', 'total', 'paidBefore', 'frequency', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && (!('lender' in data.keys()) || data.lender == null || (data.lender is string && data.lender.size() <= 60))
        && data.total is number && data.total > 0
        && data.paidBefore is number && data.paidBefore >= 0
        && data.frequency in ['daily', 'monthly', 'everyMonths', 'yearly', 'none']
        && (!('everyMonths' in data.keys()) || data.everyMonths == null || (data.everyMonths is int && data.everyMonths >= 1 && data.everyMonths <= 60))
        && (!('installment' in data.keys()) || data.installment == null || (data.installment is number && data.installment > 0))
        && (!('nextDue' in data.keys()) || data.nextDue == null || data.nextDue is timestamp)
        && (!('anchorDay' in data.keys()) || data.anchorDay == null || (data.anchorDay is int && data.anchorDay >= 1 && data.anchorDay <= 31))
        && (!('paySource' in data.keys()) || data.paySource == null || data.paySource in ['budget', 'wallet', 'none'])
        && (!('categoryId' in data.keys()) || data.categoryId == null || data.categoryId is string)
        && (!('walletId' in data.keys()) || data.walletId == null || data.walletId is string)
        && data.createdAt is timestamp;
    }

    // One payment towards a repayment, with the expense or wallet entry it
    // added (if any) and the due date it moved on from (if it did).
    function isValidRepaymentPayment(data) {
      return data.keys().hasOnly(['repaymentId', 'amount', 'date', 'source', 'transactionId', 'walletEntryId', 'advancedFrom', 'createdAt'])
        && data.keys().hasAll(['repaymentId', 'amount', 'date', 'source', 'createdAt'])
        && data.repaymentId is string
        && data.amount is number && data.amount > 0
        && data.date is timestamp
        && data.source in ['budget', 'wallet', 'none']
        && (!('transactionId' in data.keys()) || data.transactionId == null || data.transactionId is string)
        && (!('walletEntryId' in data.keys()) || data.walletEntryId == null || data.walletEntryId is string)
        && (!('advancedFrom' in data.keys()) || data.advancedFrom == null || data.advancedFrom is timestamp)
        && data.createdAt is timestamp;
    }

    // Something the user is saving up for. doneAt is set once they mark it
    // done (bought it).
    function isValidGoal(data) {
      return data.keys().hasOnly(['name', 'iconKey', 'color', 'target', 'savedBefore', 'targetDate', 'doneAt', 'addSource', 'categoryId', 'walletId', 'createdAt'])
        && data.keys().hasAll(['name', 'iconKey', 'color', 'target', 'savedBefore', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.iconKey is string && data.iconKey.size() > 0 && data.iconKey.size() <= 40
        && data.color is int
        && data.target is number && data.target > 0
        && data.savedBefore is number && data.savedBefore >= 0
        && (!('targetDate' in data.keys()) || data.targetDate == null || data.targetDate is timestamp)
        && (!('doneAt' in data.keys()) || data.doneAt == null || data.doneAt is timestamp)
        && (!('addSource' in data.keys()) || data.addSource == null || data.addSource in ['budget', 'wallet', 'none'])
        && (!('categoryId' in data.keys()) || data.categoryId == null || data.categoryId is string)
        && (!('walletId' in data.keys()) || data.walletId == null || data.walletId is string)
        && data.createdAt is timestamp;
    }

    // Money added to or taken out of a goal, with the expense or wallet
    // entry it added (if any).
    function isValidGoalEntry(data) {
      return data.keys().hasOnly(['goalId', 'kind', 'amount', 'date', 'source', 'transactionId', 'walletEntryId', 'createdAt'])
        && data.keys().hasAll(['goalId', 'kind', 'amount', 'date', 'source', 'createdAt'])
        && data.goalId is string
        && data.kind in ['add', 'takeOut']
        && data.amount is number && data.amount > 0
        && data.date is timestamp
        && data.source in ['budget', 'wallet', 'none']
        && (!('transactionId' in data.keys()) || data.transactionId == null || data.transactionId is string)
        && (!('walletEntryId' in data.keys()) || data.walletEntryId == null || data.walletEntryId is string)
        && data.createdAt is timestamp;
    }

    // A broker account the user invests through; its value is copied in
    // from the broker's app.
    function isValidInvestAccount(data) {
      return data.keys().hasOnly(['name', 'color', 'createdAt'])
        && data.keys().hasAll(['name', 'color', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.color is int
        && data.createdAt is timestamp;
    }

    // Money put in or taken out, a dividend, or a value copied in (the
    // whole value, so it may be zero), with the transaction or wallet
    // entry it added (if any).
    function isValidInvestEntry(data) {
      return data.keys().hasOnly(['accountId', 'kind', 'amount', 'date', 'source', 'transactionId', 'walletEntryId', 'createdAt'])
        && data.keys().hasAll(['accountId', 'kind', 'amount', 'date', 'source', 'createdAt'])
        && data.accountId is string
        && data.kind in ['deposit', 'withdraw', 'dividend', 'value']
        && data.amount is number
        && ((data.kind == 'value' && data.amount >= 0) || (data.kind != 'value' && data.amount > 0))
        && data.date is timestamp
        && data.source in ['budget', 'wallet', 'none']
        && (!('transactionId' in data.keys()) || data.transactionId == null || data.transactionId is string)
        && (!('walletEntryId' in data.keys()) || data.walletEntryId == null || data.walletEntryId is string)
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserDoc(request.resource.data);
      // Only the owner, when deleting their account (Profile → Delete
      // account removes transactions, categories, then this doc).
      allow delete: if isOwner(userId);

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCategory(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /wallets/{walletId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWallet(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /people/{personId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPerson(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /walletEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWalletEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /repayments/{repaymentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidRepayment(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /repaymentPayments/{paymentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidRepaymentPayment(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidGoal(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /goalEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidGoalEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /investAccounts/{accountId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidInvestAccount(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /investEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidInvestEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
